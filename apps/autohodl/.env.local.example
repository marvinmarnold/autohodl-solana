# Copy to .env.local and fill in real values before running dev or deploying.

TELEGRAM_BOT_TOKEN=          # from BotFather — format: 1234567890:ABCDEFabcdef...
PRIVY_APP_ID=                # from Privy dashboard → Settings → API keys
PRIVY_APP_SECRET=            # from Privy dashboard → Settings → API keys
SESSION_SECRET=              # random 32+ char string — run: openssl rand -base64 32

# For local dev, use http://localhost:3000
# For production, use your Vercel deployment URL, e.g. https://autohodl.vercel.app
NEXT_PUBLIC_MINI_APP_URL=http://localhost:3000

# MoonPay publishable key — from MoonPay dashboard → Developers → API keys
# Use the test key (pk_test_...) for sandbox, live key (pk_live_...) for production.
NEXT_PUBLIC_MOONPAY_API_KEY=

# Solana RPC endpoint — e.g. https://api.mainnet-beta.solana.com or Helius/QuickNode
SOLANA_RPC_URL=

# The autoHODL protocol PDA public key (base58) that receives SPL Token.approve delegation
AUTOHODL_DELEGATE_PUBKEY=

# Privy app ID — exposed to client bundle for the Privy React SDK
NEXT_PUBLIC_PRIVY_APP_ID=    # same value as PRIVY_APP_ID

# EC private key for Privy custom-auth JWTs (ES256 / P-256).
# Generate once:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -outform PEM 2>/dev/null | base64 | tr -d '\n'
# Then register JWKS URL in Privy dashboard → Authentication → Custom auth → JWKS URL:
#   https://<your-domain>/api/auth/jwks
PRIVY_CUSTOM_AUTH_PRIVATE_KEY=

# Solana RPC — also needed in the client bundle for tx broadcasting in the WebView
NEXT_PUBLIC_SOLANA_RPC_URL=  # same value as SOLANA_RPC_URL
